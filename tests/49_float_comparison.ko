print 1 < 1.5, " ", 2.0 == 2, " ", 0.1 + 0.2 == 0.3, " ", 1.5 > 1 > 0.5, " ", 1 <= 1.0 <= 1, " ", 3 != 3.0, " ", 2.5 >= 2.5  -- => 1 1 0 1 1 0 1
print 1.0 == 1 == 1.0, " ", 1.5 < 2.5 < 2  -- => 1 0
n = 0
function next(): ^n += 1; return n * 1.0
print 0.5 < next() < 5, " ", n             -- => 1 1  (the middle operand is evaluated once)
print 5.5 < 3 < next(), " ", n             -- => 0 1  (stops at the first false link)
print 1 < 2.5 <= 2.5 < 3, " ", -0.0 == 0.0, " ", 0.1 * 3 == 0.3, " ", 0.5 * 2 == 1  -- => 1 1 0 1
