print 1 < 2, " ", 2 < 1, " ", 1 <= 1, " ", 2 >= 3, " ", 3 == 3, " ", 3 != 3  -- => 1 0 1 0 1 0
print 1 && 2, " ", 0 && 1, " ", 0 || 5, " ", 0 || 0, " ", !0, " ", !7, " ", !1  -- => 1 0 1 0 1 0 0
print 5 > 3 && 2 > 1               -- => 1
print 1 || 0, " ", 0 && 1          -- => 1 0
print 1 + 1 == 2, " ", 1 < 2 == 1  -- => 1 1
