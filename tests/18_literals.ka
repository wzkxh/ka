foo = fn() { return 10 }
bar = fn(): =10 -- '=' is a short 'return'
baz = fn(a,b): return a+b
xyz = fn(n): m=2*n; return m
abc = fn(n) {m=2*n; =m}
print foo(), " ", bar(), " ", baz(3, 4), " ", xyz(5), " ", abc(6)
sq = fn(x) {
    y = x * x
    =y
}
cube = fn(x):
    y = x * x * x
    return y
print sq(9), " ", cube(3)
apply = fn(f, v): =f(v)
print apply(fn(x): =x + 1, 41), " ", apply(sq, 12)
print apply(fn(x) {
    t = x * 10
    =t + 5
}, 7)
print (fn(a, b): =a * b)(6, 7)
fn twice(f, x): =f(f(x))
print twice(sq, 3), " ", twice(fn(x): =x * 2, 5)
g = twice
print g(abc, 1)
fn sqf(x): =x * x
print sqf(7)
