fn foo(a, b) { print "foo ", a, " ", b }
fn bar(a): return 2 * a
fn baz():
    a = 2
    b = 3
    return a + b
fn sq(x): return x * x
fn noret(): x = 1
fn bare(): return
foo(1, 2)
print bar(21), " ", baz(), " ", sq(9), " ", noret(), " ", bare()
print later(5) -- used before its definition
fn later(x): return x + 1000
fn sub3(a, b, c): return a - b * c
print sub3(100, 6, 7)
print 1 + bar(2) * 3
