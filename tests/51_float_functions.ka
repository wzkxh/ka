function area(r): return 3.14159 * r * r
function half(x): return x / 2
function scale(f, v): =f(v) * 2
PI = 3.14159
TAU = PI * 2
print area(2), " ", half(5.0), " ", scale(\x: =x + 0.5, 1)  -- => 12.56636 2.5 3.0
print TAU, " ", PI                       -- => 6.28318 3.14159
function avg(a, b): return (a + b) / 2
print avg(1.0, 2.0), " ", avg(3.5, 0.5)  -- => 1.5 2.0
