print 1 + 2 * 3                                    -- => 7
print (1 + 2) * 3                                  -- => 9
print 7 \ 2, " ", -7 \ 2, " ", 7 % 3, " ", -7 % 3  -- => 3 -3 1 -1
print 10 - 3 - 2                                   -- => 5
print 2 * 3 % 4                                    -- => 2
print -5 + 3                                       -- => -2
print - -4                                         -- => 4
print 100 \ 10 \ 5                                 -- => 2
print 2 * -3                                       -- => -6
