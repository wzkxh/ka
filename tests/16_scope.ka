g = 10
function readg(): return g * 2
function setg():
  ^g = g + 1
function shadow():
  g2 = 5
  return g2
function newglobal():
  ^ng = 77
setg()
setg()
newglobal()
print g, " ", readg(), " ", ng, " ", shadow()  -- => 12 24 77 5
function blocks():
  i = 0
  while i < 3 { inner = i; i = i + 1 }
  return inner -- blocks do not create scopes
print blocks()                                 -- => 2
x = 1
function f(): x = 2; return x
print f(), " ", x                              -- => 2 1
