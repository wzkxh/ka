print 7 \ 3, " ", 7 % 3                   -- => 2 1
print -7 \ 3, " ", -7 % 3                 -- => -3 2
print 7 \ -3, " ", 7 % -3                 -- => -3 -2
print -7 \ -3, " ", -7 % -3               -- => 2 -1
print 6 \ -3, " ", 6 % -3, " ", -6 \ 3, " ", -6 % 3        -- => -2 0 -2 0
print 7.5 \ 2, " ", 7.5 % 2, " ", -7.5 \ 2, " ", -7.5 % 2  -- => 3 1.5 -4 0.5
print 7.5 \ -2, " ", 7.5 % -2, " ", -7.5 \ -2, " ", -7.5 % -2   -- => -4 -0.5 3 -1.5
print -6.0 % 3, " ", 6.0 % -3, " ", -0.0 % 5     -- => 0.0 0.0 0.0  (a zero remainder is +0.0)
print -0.3 \ 0.1, " ", 0.3 \ 0.1, " ", -1e-5 \ 3.0   -- => -3 2 -1
print 6049232.4789095735 \ 455.61461813570327          -- => 13277 (the quotient a - fmod(a, b) / b is 13276.999999999998 inside)

-- x \ y * y + x % y == x, and x % y has the sign of y with |x % y| < |y|: all the pairs of a small range
-- (for floats the identity holds only up to rounding; the float values below are exactly representable halves)
bad = 0
i = -9
while i <= 9:
  j = -5
  while j <= 5:
    if j != 0:
      r = i % j
      if (i \ j) * j + r != i: bad += 1
      if r != 0 && (r < 0) != (j < 0): bad += 1
      if r * r >= j * j: bad += 1
    j += 1
  i += 1
print bad                                  -- => 0

fbad = 0
x = -4.5
while x <= 4.5:
  y = -2.5
  while y <= 2.5:
    if y != 0.0:
      rf = x % y
      if (x \ y) * y + rf != x: fbad += 1
      if rf != 0.0 && (rf < 0.0) != (y < 0.0): fbad += 1
    y += 0.5
  x += 0.5
print fbad                                 -- => 0
