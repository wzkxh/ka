function apply(f, v): =f(v)
print apply(function(x): =x*2, 5)
print (function(a): if a: =2*a; else: =0)(4), (function(a): if a: =2*a; else: =0)(0)
c = 1
function t1():
  if c: while c < 3:
    ^c = c + 1
    print "c=", c
t1()
if 0: print "x"
else if c == 3: print "else-if ok"
a = 3; b = 2
print a ^b, " ", a ^ b ^ 2  -- => 9 81
function g(): ^gg = 5
g()
print a, ^gg                -- => 35
print "é ^u00e9", 'é'       -- => é éé
function deep(n): if n == 0: =0 else: =1 + deep(n - 1)
print deep(5000)            -- => 5000

