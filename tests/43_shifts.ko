print 1 <* 1, " ", 1 <* 64, " ", 1 <* 63, " ", 1 *> 1, " ", 1 <* 65, " ", 1 <* -1  -- => 2 1 -9223372036854775808 -9223372036854775808 2 -9223372036854775808
