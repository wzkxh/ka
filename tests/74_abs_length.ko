-- unary |: the absolute value of an int or a float, the length of a str (bytes) or of a text (characters)
print |-5, ' ', |5, ' ', |0                                   -- => 5 5 0
x = -42
print |x, ' ', |x + 1, ' ', |-x, ' ', -|x                     -- => 42 43 42 -42
print |(-9223372036854775807 - 1)                             -- => -9223372036854775808
print |-2.5, ' ', |2.5, ' ', |-0.0, ' ', |(0.0 - 1e300)         -- => 2.5 2.5 0.0 1e+300
f = -1.25
print |f * 2, ' ', |f < 2, ' ', |f == 1.25                     -- => 2.5 1 1
print |'abc', ' ', |'', ' ', |'a^00b', ' ', |'é'                -- => 3 0 3 2
print |"abc", ' ', |"", ' ', |"é€😀", ' ', |"a^00b"             -- => 3 0 3 3
s = 'hello'
t = "héllo"
print |s, ' ', |t, ' ', |(s + s), ' ', |(t + "!")              -- => 5 5 10 6
print |'ab' + |"cd" * 10                                       -- => 22
print 6 | |-1, ' ', |-3 | 4, ' ', 5 | |'ab'                    -- => 7 7 7
-- the length is an int
if |s > 3: print "long"                                        -- => long
if |'': print "not reached" else: print "empty"                -- => empty
n = |t
n += |s
print n                                                        -- => 10
-- in functions the type of the result follows the argument
function absolute(x): return |x
function length(s): return |s
function size_of(x) {
  =|x
}
print absolute(-7), ' ', length("añ€"), ' ', size_of('abcd')   -- => 7 3 4
function fabs(x): return |x
print fabs(-1.5), ' ', fabs(2.0) + 1                           -- => 1.5 3.0
big = 1e308 * 10
print |(big - big), ' ', |-big                                 -- => nan inf
