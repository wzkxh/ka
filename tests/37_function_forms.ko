function f1 x: return x + 1
function f2 x {return x * 2}
\f3 x: = x - 1
\f4 x {=x*3}
\f5(a,b): =a+b
\f6(){=7}
function f7(x): return x
print f1(1), " ", f2(2), " ", f3(3), " ", f4(4), " ", f5(5, 6), " ", f6(), " ", f7(8)  -- => 2 4 2 12 11 7 8
g = \x: = x + 100
h = function y {return y * y}
k = \(a,b){=a-b}
print g(1), " ", h(5), " ", k(9, 4)  -- => 101 25 5
print (\x:=x*2)(21)               -- => 42
function apply(f, v): =f(v)
print apply(\x:=x+1,41), " ", apply(function z {return z * 3}, 5)  -- => 42 15
\(): print "literal as a statement"   -- never called
