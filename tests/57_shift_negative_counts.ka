print 1 >> -3, " ", 8 << -3, " ", -16 +> -2                  -- => 8 1 -64  (a negative count shifts the other way)
print -1 << -63, " ", 1 << -64, " ", 1 >> -64, " ", -1 +> -64   -- => 1 0 0 0
print 5 << -1, " ", 5 >> -1, " ", -5 +> -1                     -- => 2 10 -10
print 1 *> -1, " ", 1 <* -1, " ", 1 *> -65, " ", 3 <* -2        -- rotates: 2 -9223372036854775808 2 -4611686018427387904
x = 3; x <<= -1; print x                                       -- 1
x = 3; x >>= -2; print x                                       -- 12
x = -8; x +>= -1; print x                                      -- -16
print #8000000000000000 >> -1, " ", 1 << (-9223372036854775807 - 1)   -- => 0 0
