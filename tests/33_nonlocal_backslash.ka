fn counter():
    n = 0
    fn bump(): \n = n + 1
    fn get(): =n
    bump(); bump(); bump()
    return get()
print counter()
fn outer():
    a = 1
    fn mid():
        b = 10
        fn inner():
            \b = b + 1    -- the b of mid
            \a = a + 100  -- no a in mid: the a of outer
        inner()
        return b
    return mid() * 1000 + a
print outer()
