function outer(n):
  total = 0
  function add(k):
    @total = total + k + n
  function twice(k):
    add(k)
    add(k)
    function deeper():
      return total * 100 + n
    return deeper()
  i = 1
  while i <= 3:
    add(i)
    i = i + 1
  r = twice(10)
  print "total=", total
  return r
print outer(5)
function rec_nested(n):
  function go(k):
    if k == 0: return 0
    return k + go(k - 1) + n * 0
  return go(n)
print rec_nested(100)  -- => 5050

