^a = 1            -- the same as a = 1 at the top level
function inc(): ^a = a + 1
function show(): print ^a, " ", a
inc(); inc()
show()
print a
function newg(): ^created = 42
newg()
print created
function mixed(x):
  r = x * 2
  ^total = r + 1     -- total is global, r is local
  return r
print mixed(5), " ", total
function outer():
  v = 1
  function inner():
    ^v = 100       -- the global v, not the v of outer
    return v       -- after ^v the plain name is the global too
  r = inner()
  return r * 1000 + v
print outer(), " ", v
