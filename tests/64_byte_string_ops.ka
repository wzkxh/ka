a = 'apple'
b = 'apple'
c = 'apricot'
print (a == b), ' ', (a != c), ' ', (a < c), ' ', (c > a), ' ', (a <= b), ' ', (c >= b)
chain1 = 'a' < 'b' < 'c'
chain2 = 'a' < 'c' < 'b'
chain3 = 'a' < 'b' < 'c' < 'd'
chain4 = 'a' < 'c' < 'b' < 'd'
print chain1, ' ', chain2, ' ', chain3, ' ', chain4
empty_eq = '' == ''
empty_lt = '' < 'a'
a_gt_empty = 'a' > ''
print empty_eq, ' ', empty_lt, ' ', a_gt_empty
high_gt = '^ff' > '^7f'
zero_lt = 'A^00B' < 'A^00C'
print high_gt, ' ', zero_lt
x = 'Hello'
y = x + ' '
y += 'world'
y += '!'
print y
z = 'foo' + 'bar'
print z
function join(a, b): return a + b
print join('left', 'right')
function less(a, b): return a < b
print less('abc', 'abd')
function decorate(s): return s + '!'
print decorate('immutable')
empty = '' + ''
print empty == ''
dup = 'ha'
dup += dup
print dup

-- longer strings: a few chars, a dozen, and one hundred bytes
short_a = 'abc'
short_b = 'abd'
print (short_a < short_b), ' ', (short_a + short_b)
mid_a = 'abcdefghijkl'
mid_b = 'abcdefghijkm'
print (mid_a < mid_b), ' ', (mid_a + mid_b)
long_a = '0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789'
long_b = '0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456788'
print (long_a == long_a), ' ', (long_a < long_b), ' ', (long_a + long_b)
