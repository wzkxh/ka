-- unary *n: 1 if the int n is prime, else 0 (an operand of * is an int; after an operand * is multiplication)
print *-2, ' ', *-1, ' ', *0, ' ', *1, ' ', *2, ' ', *3, ' ', *4                    -- => 0 0 0 0 1 1 0
print *65, ' ', *66, ' ', *67, ' ', *97, ' ', *100, ' ', *101                       -- => 0 0 1 1 0 1
print *-7, ' ', *(0 - 9223372036854775807 - 1)                                      -- => 0 0
print *7 + *8, ' ', 3 * *5, ' ', **7, ' ', 2 * *3 * 5                               -- => 1 3 0 10
print *2147483647, ' ', *1000000007, ' ', *998244353                                 -- => 1 1 1
print *(1000003 * 997), ' ', *(2 ^ 31 - 1), ' ', *999999937, ' ', *999999999            -- => 0 1 1 0
-- the numbers from -2 to 100: the number and 1 if it is a prime
n = -2
while n <= 100:
  print n, ' ', *n
  n += 1
-- the same with trial division written out, up to 5000 and for the negative numbers
function slow(n) {
  if n < 2: return 0
  d = 2
  while d * d <= n {
    if n % d == 0: return 0
    d += 1
  }
  return 1
}
bad = 0
n = -100
while n <= 5000:
  if *n != slow(n): bad += 1
  n += 1
print "mismatches: ", bad                                                           -- => mismatches: 0
-- counting the primes
count = 0
n = 0
while n < 100000:
  count += *n
  n += 1
print "primes below 100000: ", count                                                -- => primes below 100000: 9592
