print 2^10
print 2^3^2
print -2^2          -- unary minus binds tighter than ^: (-2)^2
print (-2)^3
print -2^3
print 3^0, " ", 0^0, " ", 0^5, " ", 5^1
print 2^62
print 2^63
print 2^64
print 2 * 3^2
print 2^2*3
print 7 ^ 2 % 5
print 10^18
a = 3
print a^2^2
print 2^-0
print 2^-1 ^ 2 -- not an error: 2^((-1)^2) = 2^1
