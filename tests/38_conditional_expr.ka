a = 5
print a > 3 ? 1 ! 2, " ", a > 9 ? 1 ! 2  -- => 1 2
print a < 3 ? 10 ! a < 6 ? 20 ! 30       -- => 20  (right-associative: a<3 ? 10 ! (a<6 ? 20 ! 30))
x = 0
function bump(): ^x = x + 1; return x
print 1 ? bump() ! bump(), " ", x        -- => 1 1  (only the chosen branch is evaluated)
print 0 ? bump() ! 7, " ", x             -- => 7 1
f = a > 3 ? (\x: =x + 1) ! (\x: =x - 1)  -- functions work too (same type in both branches)
print f(10)                              -- => 11
print (a ? 1 ! 2) + 10                   -- => 11
print 1 ? 2 ? 3 ! 4 ! 5                  -- => 3
print a != 5 ? 1 ! 2                     -- => 2
print !0 ? 8 ! 9
print a >
  3 ?
  1 !
  0

-- the whole output:
--   1 2
--   20
--   1 1
--   7 1
--   11
--   11
--   3
--   2
--   8
--   1
