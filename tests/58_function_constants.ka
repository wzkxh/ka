function area(r):
  PI = 3.14159                   -- a constant of this function
  return PI * r * r
print area(2.0)                  -- => 12.56636
function f():
  K = 10
  M = K * 2 + 1                  -- constants defined above can be used
  function inner(): return K + M -- visible in nested functions
  return inner()
print f()                        -- => 31
SIZE_G = 5
print SIZE_G                     -- => 5
function g():
  SIZE_G = 7                     -- a constant of g, the global one is not touched
  return SIZE_G
print g(), " ", SIZE_G           -- 7 5
function h(n):
  DOUBLE = n * 2                 -- the value of a constant can be any expression (here: a parameter)
  print DOUBLE                   -- => 8
h(4)
function BIG(): return 1000      -- a constant function inside a function
function k():
  function SMALL(): return 1
  return SMALL() + BIG()
print k()                        -- => 1001
