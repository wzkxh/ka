print 2^10                               -- => 1024
print 2^3^2                              -- => 512
print -2^2                               -- => 4  (unary minus binds tighter than ^: (-2)^2)
print (-2)^3                             -- => -8
print -2^3                               -- => -8
print 3^0, " ", 0^0, " ", 0^5, " ", 5^1  -- => 1 1 0 5
print 2^62                               -- => 4611686018427387904
print 2^63                               -- => -9223372036854775808
print 2^64                               -- => 0
print 2 * 3^2                            -- => 18
print 2^2*3                              -- => 12
print 7 ^ 2 % 5                          -- => 4
print 10^18                              -- => 1000000000000000000
a = 3
print a^2^2                              -- => 81
print 2^-0                               -- => 1
print 2^-1 ^ 2 -- => 2  (not an error: 2^((-1)^2) = 2^1)
