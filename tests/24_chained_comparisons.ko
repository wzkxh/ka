print 1 < 2 < 3, " ", 1 < 3 < 2, " ", 3 > 2 > 1, " ", 1 <= 1 <= 1, " ", 1 < 2 > 1  -- => 1 0 1 1 1
print 1 == 1 == 1, " ", 1 == 1 == 2, " ", 1 != 2 != 1  -- => 1 0 1
n = 0
function next(): ^n = n + 1; return n
print 0 < next() < 5, " ", n                           -- => 1 1  (the middle operand is evaluated once)
print 5 < 3 < next(), " ", n                           -- => 0 1  (stops at the first false link)
print 1 < 2 < 3 < 4, " ", 1 < 2 < 3 < 3                -- => 1 0
print 1 < 2 == 1                                       -- => 1  (different levels are not chained)
print 1 <= 1 <= 2, " ", 3 >= 3 >= 2, " ", 3 >= 3 >= 4, " ", 2 <= 1 <= 5  -- => 1 1 0 0
print 1 <= 2 >= 2 <= 3, " ", 5 >= 5 >= 5 >= 5, " ", 1 <= 2 <= 3 <= 2  -- => 1 1 0
print 5 >= 6 >= next(), " ", n                         -- => 0 1  (not evaluated: n stays 1)
print 1 <= next() <= 1, " ", n                         -- => 0 2  (evaluated once: n becomes 2)
print 2 >= next() >= 3, " ", n                         -- => 0 3  (next() is 3: 2 >= 3 is false, stops)
