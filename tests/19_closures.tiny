make_counter = fn() {
    c = 0
    fn() {
        nonlocal c
        c = c + 1
        c
    }
}
c1 = make_counter()
c2 = make_counter()
c1(); c1()
print c1(), " ", c2(), " ", c1()
adder = fn(n) fn(x) x + n
add5 = adder(5)
add10 = adder(10)
print add5(1), " ", add10(1), " ", adder(100)(1)
sq = fn(x) x * x
compose = fn(f, g) fn(x) f(g(x))
inc_then_sq = compose(sq, fn(x) x + 1)
print inc_then_sq(4)
fact = fn(n):
    if n <= 1: return 1
    return n * fact(n - 1)
print fact(10)
fn wrap(n):
    local_fact = fn(k):
        if k <= 1: return 1
        return k * local_fact(k - 1)
    return local_fact(n)
print wrap(6)
i = 0
total = 0
while i < 5:
    h = adder(i)
    total = total + h(100)
    i = i + 1
print total
