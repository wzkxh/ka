fn outer(n):
    total = 0
    fn add(k):
        nonlocal total
        total = total + k + n
    fn twice(k):
        add(k)
        add(k)
        fn deeper():
            return total * 100 + n
        return deeper()
    i = 1
    while i <= 3:
        add(i)
        i = i + 1
    r = twice(10)
    print "total=", total
    return r
print outer(5)
fn rec_nested(n):
    fn go(k):
        if k == 0: return 0
        return k + go(k - 1) + n * 0
    return go(n)
print rec_nested(100)
