-- The generator is SplitMix64 and starts in the same state every time: the numbers of a program are always the same.

print ?0                                                    -- => 1592342178222199016  (the first raw 64 bits (as a signed int); every program starts with the same state)
print ?0                                                    -- => -5947552309429306528  (the second one)
print ?-12345                                               -- => 0  (a negative argument sets the state to its absolute value and gives 0)
print ?0                                                    -- => 2454886589211414944  (the first number after that state)
?-12345                                                     -- a statement: no warning; the state is the same as before
print ?0                                                    -- => 2454886589211414944  (the same number again)
?-7                                                       
print ?10, " ", ?10, " ", ?10, " ", ?10, " ", ?10, " ", ?10  -- => 7 4 6 3 4 5  (?n is in 0..n-1)
print ?1, " ", ?1, " ", ?1                                  -- => 0 0 0  (the range 0..0)
print ?100, " ", ?1000000007, " ", ?9223372036854775807     -- => 25 587864266 8483179396677329709  (bigger ranges)
?(-9223372036854775807 - 1)                                 -- the smallest int: the state becomes 2^63 (its negation is itself)
print ?0                                                    -- => 5196802822362493915
?-2024                                                    
print ?1.0, " ", ?1.0, " ", ?100.0                          -- => 0.62276553664611 0.0972319084876927 29.8576161113358  (a float argument gives a float in [0,x))
print ?0.0, " ", ?5e-324, " ", ?5e-324                      -- => 0.0 0.0 0.0  (the result is always below x: with the smallest x only 0.0 is possible)
x = ?10                                                     -- x is an int
y = ?2.5                                                    -- y is a float

?-31337
x = ?10
y = ?2.5
print x, " ", y                                             -- => 3 0.408730997955377  (x is an int, y is a float)

-- the same count of ones as the C version gives in 1000 draws
?-99
ones = 0; i = 0
while i < 1000: ones += ?2; i += 1
print ones                                                  -- => 493

-- ? binds like the other unary operators and works inside expressions
?-5
print ?5 + ?5, " ", -?10                                    -- => 7 -3  (left to right)
print 1 ? ?3 ! ?4                                           -- => 2  (only the chosen branch draws a number)
